            ],
            "url": {
              "raw": "{{base_url}}/api/projects/",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", ""]
            },
            "description": "Retrieves all projects belonging exclusively to the authenticated user."
          }
        },
        {
          "name": "List Projects - Unauthenticated (Expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/projects/",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", ""]
            },
            "description": "Negative test: accessing CRUD list endpoint without token returns HTTP 401."
          }
        },
        {
          "name": "Create Project (POST /api/projects/)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var data = pm.response.json();",
                  "    if (data.id) {",
                  "        pm.collectionVariables.set('project_id', String(data.id));",
                  "        console.log('Created project id:', data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Smart Agriculture Sensor Node\",\n  \"description\": \"Soil nitrogen, phosphorus, and moisture monitoring system with solar harvesting.\",\n  \"technologies\": \"ESP32, LoRaWAN, C++, MQTT\",\n  \"github_url\": \"https://github.com/sathwik3404-dev/smart-agri-lora\",\n  \"live_demo_url\": \"https://agri-demo.example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/projects/",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", ""]
            },
            "description": "Creates a new project owned by the authenticated user. Returns HTTP 201."
          }
        },
        {
          "name": "Create Project - Empty Title (Expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{auth_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\",\n  \"description\": \"Missing title validation test\",\n  \"technologies\": \"Python\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/projects/",
              "host": ["{{base_url}}"],
              "path": ["api", "projects", ""]
            },
            "description": "Validation test: rejects empty title with HTTP 400 Bad Request."
          }
        },
        {
